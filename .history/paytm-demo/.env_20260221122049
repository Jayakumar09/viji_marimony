# Paytm Payment Gateway Configuration
# Get your credentials from https://dashboard.paytm.com/

# Merchant ID (from Paytm Dashboard)
PAYTM_MERCHANT_ID=YOUR_MERCHANT_ID

# Merchant Key (from Paytm Dashboard - keep this secret!)
PAYTM_MERCHANT_KEY=YOUR_MERCHANT_KEY

# Website Name (use WEBSTAGING for test mode)
PAYTM_WEBSITE=WEBSTAGING

# Channel ID (WEB for website, WAP for mobile)
PAYTM_CHANNEL_ID=WEB

# Industry Type
PAYTM_INDUSTRY_TYPE_ID=Retail

# Server Configuration
PORT=5006

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Test Mode Flag (true for testing, false for production)
PAYTM_TEST_MODE=true

# Callback URL (where Paytm will redirect after payment)
PAYTM_CALLBACK_URL=http://localhost:5006/api/payment/callback
