# Instamojo Payment Gateway Configuration
# Get your credentials from https://www.instamojo.com/

# API Key (from Instamojo Dashboard -> API & Plugins)
INSTAMOJO_API_KEY=YOUR_API_KEY

# Auth Token (from Instamojo Dashboard -> API & Plugins)
INSTAMOJO_AUTH_TOKEN=YOUR_AUTH_TOKEN

# Salt (from Instamojo Dashboard -> API & Plugins)
INSTAMOJO_SALT=YOUR_SALT

# Server Configuration
PORT=5007

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Test Mode Flag (true for testing, false for production)
INSTAMOJO_TEST_MODE=true

# Redirect URL (where Instamojo will redirect after payment)
INSTAMOJO_REDIRECT_URL=http://localhost:5007/api/payment/callback

# Webhook URL (for payment notifications)
INSTAMOJO_WEBHOOK_URL=http://localhost:5007/api/payment/webhook
