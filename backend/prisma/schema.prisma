// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  phone             String?  @unique
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  gender            String
  dateOfBirth       DateTime @map("date_of_birth")
  age               Int
  community         String   @default("Boyar")
  subCaste          String?  @map("sub_caste")
  city              String
  state             String
  country           String   @default("India")
  education         String?
  profession        String?
  income            String?
  maritalStatus     String   @map("marital_status")
  height            String?  // in cm
  weight            String?  // in kg
  complexion        String?
  profilePhoto      String?  @map("profile_photo")
  photos            String?  // JSON string for SQLite
  bio               String?
  familyValues      String?  @map("family_values")
  aboutFamily       String?  @map("about_family")
  isVerified        Boolean  @default(false) @map("is_verified")
  isPremium         Boolean  @default(false) @map("is_premium")
  isActive          Boolean  @default(true) @map("is_active")
  emailVerified     Boolean  @default(false) @map("email_verified")
  phoneVerified     Boolean  @default(false) @map("phone_verified")
  photosVerified    Boolean  @default(false) @map("photos_verified")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Horoscope Fields
  raasi             String?  // Moon Sign (Raasi)
  natchathiram      String?  // Star/Nakshatra
  dhosam            String?  // Dhosam (Yes/No/-details)
  birthDate         String?  @map("birth_date") // Birth date for horoscope
  birthTime         String?  @map("birth_time") // Birth time for horoscope
  birthPlace        String?  @map("birth_place") // Birth place for horoscope

  // Family Background Fields
  fatherName        String?  @map("father_name")
  fatherOccupation  String?  @map("father_occupation")
  fatherCaste       String?  @map("father_caste")
  motherName        String?  @map("mother_name")
  motherOccupation  String?  @map("mother_occupation")
  motherCaste       String?  @map("mother_caste")

  // Subscription Fields
  subscriptionTier   String?  @map("subscription_tier") // FREE, STANDARD, PREMIUM, ELITE
  successFee        Float?   @map("success_fee") // Success fee for premium services
  subscriptionStart DateTime? @map("subscription_start")
  subscriptionEnd   DateTime? @map("subscription_end")

  // Verification Status
  manualVerificationStatus String?  @map("manual_verification_status") // PENDING, APPROVED, REJECTED
  manualVerificationNotes String?  @map("manual_verification_notes")

  // Relations
  sentInterests     Interest[] @relation("SentInterests")
  receivedInterests Interest[] @relation("ReceivedInterests")
  sentMessages      Message[]  @relation("SentMessages")
  receivedMessages  Message[] @relation("ReceivedMessages")
  photoVerifications PhotoVerification[] @relation("UserPhotos")
  documents         Document[] @relation("UserDocuments")

  @@map("users")
}

model Document {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  documentType  String   @map("document_type") // GOVERNMENT_ID, ADDRESS_PROOF, FINANCIAL_PROOF, etc.
  documentUrl   String?  @map("document_url")
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectedReason String? @map("rejected_reason")
  reviewedBy    String?  @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user          User     @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model PhotoVerification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  photoUrl    String   @map("photo_url")
  photoType   String   @default("PROFILE") @map("photo_type") // PROFILE, PHOTO_GALLERY
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectedReason String? @map("rejected_reason")
  reviewedBy  String?  @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user        User     @relation("UserPhotos", fields: [userId], references: [id], onDelete: Cascade)

  @@map("photo_verifications")
}

model Interest {
  id         String      @id @default(cuid())
  senderId   String      @map("sender_id")
  receiverId String      @map("receiver_id")
  status     String @default("PENDING")
  message    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  sender   User @relation("SentInterests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedInterests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@map("interests")
}

model Message {
  id         String   @id @default(cuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String @default("ADMIN")
  isActive  Boolean  @default(true) @map("is_active")
  lastLogin DateTime? @map("last_login")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

model Subscription {
  id          String           @id @default(cuid())
  userId      String           @map("user_id")
  plan        String
  amount      Float
  startDate   DateTime         @map("start_date")
  endDate     DateTime         @map("end_date")
  status      String @default("ACTIVE")
  paymentId   String?          @map("payment_id")
  successFee  Float?           @map("success_fee")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model CustomCity {
  id        String   @id @default(cuid())
  name      String
  state     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("custom_cities")
}

model SubCaste {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sub_castes")
}

// Rasi and Natchathiram mapping for horoscope
model RasiNakshatra {
  id        String   @id @default(cuid())
  rasi      String
  nakshatra String   @unique
  rasiOrder Int      @map("rasi_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("rasi_nakshatras")
}
